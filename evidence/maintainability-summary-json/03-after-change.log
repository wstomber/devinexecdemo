$ python3 - <<'PY'  # inline check source; executed with exit=0
import csv
import hashlib
import json
from pathlib import Path

root = Path('.')
evidence = root / 'evidence/maintainability-summary-json'
checks = [
    ('curated', evidence / 'curated-with-flag/python-totals.csv', evidence / 's-curated.json'),
    ('synthetic', evidence / 'synthetic-with-flag/python-totals.csv', evidence / 's.json'),
]
failures = 0
for name, totals_path, summary_path in checks:
    with totals_path.open(newline='', encoding='ascii') as stream:
        totals = next(csv.DictReader(stream))
    expected = {key: int(totals[key]) for key in
                ('records', 'paid', 'zero', 'invalid', 'payment_cents')}
    actual = json.loads(summary_path.read_text(encoding='ascii'))
    mismatch = actual != expected
    failures += mismatch
    print(f'{name} JSON vs totals: {"1" if mismatch else "0"} mismatches; '
          f'JSON={actual}; totals={expected}')

csv_pairs = [
    ('curated results', evidence / 'curated-with-flag/python-results.csv', evidence / 'pre-change/pre-curated-results.csv'),
    ('curated totals', evidence / 'curated-with-flag/python-totals.csv', evidence / 'pre-change/pre-curated-totals.csv'),
    ('synthetic results', evidence / 'synthetic-with-flag/python-results.csv', evidence / 'pre-change/pre-synthetic-results.csv'),
    ('synthetic totals', evidence / 'synthetic-with-flag/python-totals.csv', evidence / 'pre-change/pre-synthetic-totals.csv'),
]
for name, current, previous in csv_pairs:
    current_hash = hashlib.sha256(current.read_bytes()).hexdigest()
    previous_hash = hashlib.sha256(previous.read_bytes()).hexdigest()
    mismatch = current_hash != previous_hash
    failures += mismatch
    print(f'{name} sha256: {"MISMATCH" if mismatch else "byte-identical"}; '
          f'current={current_hash}; pre-change={previous_hash}')

curated_results = evidence / 'curated-with-flag/python-results.csv'
with curated_results.open(newline='', encoding='ascii') as stream:
    cms_row = next((row for row in csv.reader(stream) if len(row) > 1 and row[1] == 'CMS-EX3'), None)
if cms_row is None:
    failures += 1
    print('CMS-EX3 row: MISSING')
else:
    print('CMS-EX3 row: ' + ','.join(cms_row))
    if cms_row[3] != '0000050000':
        failures += 1
print(f'overall mismatches: {failures}')
raise SystemExit(1 if failures else 0)
